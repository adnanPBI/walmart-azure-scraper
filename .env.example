# Only for development; never commit credentials or browser session states.
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=walmart-scraper
# AZURE_CLIENT_ID=...     # Optional user-assigned managed identity
# AZURE_STORAGE_CONNECTION_STRING=... # Local/test alternative, never in git
WALMART_MIN_DELAY_SECONDS=1.5
WALMART_MAX_DELAY_SECONDS=3.0

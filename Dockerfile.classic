# Minimal Classic Oxylabs diagnostic container (not a production scraping deployment).
# No browsers, no credentials, no HTTP calls unless separately operator-authorized.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/scraper
COPY pyproject.toml README.md /opt/scraper/
COPY walmart_azure/ /opt/scraper/walmart_azure/
RUN pip install --no-cache-dir . && useradd -r -u 10001 -d /tmp scraper
COPY config/categories.csv /opt/scraper/config/categories.csv
COPY config/stores.azure.yaml /opt/scraper/config/stores.yaml
USER 10001
ENTRYPOINT ["walmart-crawl"]
CMD ["oxylabs-probe", "--store", "3891", "--max-requests", "1", "--max-retries", "0", "--max-seconds", "90", "--categories", "/opt/scraper/config/categories.csv", "--stores", "/opt/scraper/config/stores.yaml", "--output", "/tmp/oxylabs-classic-dryrun.json"]
